exfm19_total,
exfm21_total
)
View(exfm21_total)
View(modelo19)
View(exfm19_resultado)
library(ggplot2)
library(ggplot2)
library(dplyr)
modelo19 <- lm(vol_res ~ vol_or, data = exfm19_total)
modelo21 <- lm(vol_res ~ vol_or, data = exfm21_total)
r2_19 <- summary(modelo19)$r.squared
r2_21 <- summary(modelo21)$r.squared
rmse_19 <- sqrt(
mean(
(exfm19_total$vol_res - exfm19_total$vol_or)^2,
na.rm = TRUE
)
)
rmse_21 <- sqrt(
mean(
(exfm21_total$vol_res - exfm21_total$vol_or)^2,
na.rm = TRUE
)
)
dados_validacao <- bind_rows(
exfm19_total %>%
select(vol_or, vol_res) %>%
mutate(ex = "EX19"),
exfm21_total %>%
select(vol_or, vol_res) %>%
mutate(ex = "EX21")
)
resultados <- data.frame(
ex = c("EX19", "EX21"),
r2 = c(r2_19, r2_21),
rmse = c(rmse_19, rmse_21)
)
resultados$label <- paste0(
"R² = ", round(resultados$r2, 3),
"\nRMSE = ", round(resultados$rmse, 2)
)
ggplot(
dados_validacao,
aes(x = vol_or, y = vol_res)
) +
# Pontos
geom_point(
color = "#2C7FB8",
alpha = 0.65,
size = 2.5
) +
# Linha 1:1
geom_abline(
slope = 1,
intercept = 0,
linetype = "dashed",
color = "#D95F02",
linewidth = 1
) +
# R² e RMSE
geom_text(
data = resultados,
aes(
x = Inf,
y = -Inf,
label = label
),
hjust = 1.1,
vjust = -0.5,
size = 4.5
) +
# EX19 e EX21 lado a lado
facet_wrap(~ex, nrow = 1) +
# Títulos
labs(
title = "Validação",
x = "Volume Observado",
y = "Volume Predito"
) +
# Mesma proporção nos eixos
coord_equal() +
# Tema
theme_classic(base_size = 14) +
theme(
plot.title = element_text(
face = "bold",
size = 18,
hjust = 0.5
),
strip.text = element_text(
face = "bold",
size = 14
),
axis.title = element_text(
face = "bold",
size = 13
),
axis.text = element_text(
color = "black"
)
)
ggplot(
dados_validacao,
aes(x = vol_or, y = vol_res)
) +
# Pontos
geom_point(
color = "#2C7FB8",
alpha = 0.65,
size = 2.5
) +
# Linha 1:1
geom_abline(
slope = 1,
intercept = 0,
linetype = "dashed",
color = "coral",
linewidth = 1
) +
# R² e RMSE
geom_text(
data = resultados,
aes(
x = Inf,
y = -Inf,
label = label
),
hjust = 1.1,
vjust = -0.5,
size = 4.5
) +
# EX19 e EX21 lado a lado
facet_wrap(~ex, nrow = 1) +
# Títulos
labs(
title = "Validação Predito vs. Observado",
x = "Volume Observado (m³)",
y = "Volume Predito (m³)"
) +
# Mesma proporção nos eixos
coord_equal() +
# Tema
theme_classic(base_size = 14) +
theme(
plot.title = element_text(
face = "bold",
size = 18,
hjust = 0.5
),
strip.text = element_text(
face = "bold",
size = 14
),
axis.title = element_text(
face = "bold",
size = 13
),
axis.text = element_text(
color = "black"
)
)
# ============================================================
# 5. GRÁFICO 1:1
# ============================================================
ggplot(
dados_validacao,
aes(x = vol_or, y = vol_res)
) +
geom_point(
color = "#2C7FB8",
alpha = 0.65,
size = 2.5
) +
geom_abline(
slope = 1,
intercept = 0,
linetype = "dashed",
color = "coral",
linewidth = 1
) +
geom_text(
data = resultados,
aes(
x = Inf,
y = -Inf,
label = label
),
hjust = 1.1,
vjust = -0.5,
size = 4.5
) +
facet_wrap(~ex, nrow = 1) +
labs(
title = "Validação Predito vs. Observado",
x = "Volume Observado (m³)",
y = "Volume Predito (m³)"
) +
coord_equal() +
theme_classic(base_size = 14) +
theme(
plot.title = element_text(
face = "bold",
size = 18,
hjust = 0.5
),
# Subtítulos EX19 e EX21 sem caixa
strip.background = element_blank(),
strip.text = element_text(
face = "bold",
size = 14
),
axis.title = element_text(
face = "bold",
size = 13
),
axis.text = element_text(
color = "black"
)
)
t.test(
exfm19_total$vol_res,
exfm19_total$vol_or,
paired = TRUE
)
t.test(
exfm21_total$vol_res,
exfm21_total$vol_or,
paired = TRUE
)
# EX19
ba19 <- data.frame(
observado = exfm19_total$vol_or,
predito = exfm19_total$vol_res
)
ba19$media <- (ba19$observado + ba19$predito) / 2
ba19$dif <- ba19$predito - ba19$observado
media_dif19 <- mean(ba19$dif, na.rm = TRUE)
sd_dif19 <- sd(ba19$dif, na.rm = TRUE)
lim_sup19 <- media_dif19 + 1.96 * sd_dif19
lim_inf19 <- media_dif19 - 1.96 * sd_dif19
ggplot(ba19, aes(x = media, y = dif)) +
geom_point(
color = "#2C7FB8",
alpha = 0.65,
size = 2.5
) +
geom_hline(
yintercept = 0,
linetype = "dashed",
color = "black"
) +
geom_hline(
yintercept = media_dif19,
color = "coral",
linewidth = 1
) +
geom_hline(
yintercept = c(lim_sup19, lim_inf19),
linetype = "dotted",
color = "coral"
) +
labs(
title = "Bland–Altman — EX19",
x = "Média: observado e predito (m³)",
y = "Diferença: predito − observado (m³)"
) +
theme_classic(base_size = 14)
